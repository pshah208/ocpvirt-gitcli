# Bare-metal (Agent-based) install-config.yaml template
# Render with: VARS_FILE=<vars.yaml> bash scripts/render.sh <this-file> <output>
# Variables resolved by envsubst — see scripts/render.sh
# Reference: https://docs.openshift.com/container-platform/latest/installing/installing_with_agent_based_installer/
---
apiVersion: v1
baseDomain: ${BASE_DOMAIN}
metadata:
  name: ${CLUSTER_NAME}

# Network configuration
networking:
  clusterNetwork:
    - cidr: ${CLUSTER_CIDR}
      hostPrefix: 23
  serviceNetwork:
    - ${SERVICE_CIDR}
  machineNetwork:
    - cidr: ${MACHINE_CIDR}
  networkType: ${NETWORK_TYPE}

# Control-plane configuration
controlPlane:
  name: master
  replicas: ${CP_COUNT}
  platform: {}

# Worker (compute) configuration
compute:
  - name: worker
    replicas: ${WORKER_COUNT}
    platform: {}

# Bare-metal platform configuration
platform:
  baremetal:
    apiVIPs:
      - ${API_VIP}
    ingressVIPs:
      - ${INGRESS_VIP}

# Pull secret — loaded from .secrets/pull-secret.json at render time
pullSecret: '${PULL_SECRET}'

# SSH public key — loaded from file at render time
sshKey: |
  ${SSH_KEY}

# Proxy (uncomment if required)
# proxy:
#   httpProxy: ${HTTP_PROXY}
#   httpsProxy: ${HTTPS_PROXY}
#   noProxy: ${NO_PROXY}

# Additional trust bundle (for disconnected or custom CA)
# additionalTrustBundle: |
#   -----BEGIN CERTIFICATE-----
#   <CA cert>
#   -----END CERTIFICATE-----

# Image content source policy (disconnected / mirrored installs)
# imageContentSources:
#   - mirrors:
#       - mirror.registry.example.com:5000/ocp4/openshift4
#     source: quay.io/openshift-release-dev/ocp-release
#   - mirrors:
#       - mirror.registry.example.com:5000/ocp4/openshift4
#     source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
