# GCP install-config.yaml template
# Render with: VARS_FILE=<vars.yaml> bash scripts/render.sh <this-file> <output>
# Variables resolved by envsubst — see scripts/render.sh
# Reference: https://docs.openshift.com/container-platform/latest/installing/installing_gcp/
---
apiVersion: v1
baseDomain: ${BASE_DOMAIN}
metadata:
  name: ${CLUSTER_NAME}

# Network configuration
networking:
  clusterNetwork:
    - cidr: ${CLUSTER_CIDR}
      hostPrefix: 23
  serviceNetwork:
    - ${SERVICE_CIDR}
  machineNetwork:
    - cidr: ${MACHINE_CIDR}
  networkType: ${NETWORK_TYPE}

# Control-plane configuration
controlPlane:
  name: master
  replicas: ${CP_COUNT}
  platform:
    gcp:
      type: ${GCP_CP_MACHINE_TYPE}
      # Boot disk size (GiB)
      rootVolume:
        size: ${CP_DISK}
        type: pd-ssd
      zones:
        - ${GCP_ZONE_A}
        - ${GCP_ZONE_B}
        - ${GCP_ZONE_C}

# Worker (compute) configuration
compute:
  - name: worker
    replicas: ${WORKER_COUNT}
    platform:
      gcp:
        # Use n2-standard-16+ for CNV workers (nested virt must be enabled post-install)
        type: ${GCP_WORKER_MACHINE_TYPE}
        rootVolume:
          size: ${WORKER_DISK}
          type: pd-ssd
        zones:
          - ${GCP_ZONE_A}
          - ${GCP_ZONE_B}
          - ${GCP_ZONE_C}

# GCP platform configuration
platform:
  gcp:
    projectID: ${GCP_PROJECT}
    region: ${GCP_REGION}
    # Uncomment to use an existing VPC:
    # network: ${GCP_VPC_NETWORK}
    # controlPlaneSubnet: ${GCP_CP_SUBNET}
    # computeSubnet: ${GCP_WORKER_SUBNET}

# Pull secret — loaded from .secrets/pull-secret.json at render time
pullSecret: '${PULL_SECRET}'

# SSH public key — loaded from file at render time
sshKey: |
  ${SSH_KEY}

# Proxy (uncomment if required)
# proxy:
#   httpProxy: ${HTTP_PROXY}
#   httpsProxy: ${HTTPS_PROXY}
#   noProxy: ${NO_PROXY}
